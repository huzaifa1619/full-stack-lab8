{
  "info": {
    "name": "Lab 08 Tasks",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "newCode",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 List courses",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Body is a non-empty array\", () => { const b = pm.response.json(); pm.expect(b).to.be.an(\"array\"); pm.expect(b.length).to.be.above(0); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/courses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "courses"
          ]
        }
      }
    },
    {
      "name": "02 Course stats",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Body has stats fields\", () => { const b = pm.response.json(); pm.expect(b).to.have.all.keys(\"totalCourses\",\"totalCredits\",\"overloaded\"); pm.expect(b.overloaded).to.be.a(\"boolean\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/courses/stats",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "courses",
            "stats"
          ]
        }
      }
    },
    {
      "name": "03 Get one course",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Right course\", () => pm.expect(pm.response.json().code).to.eql(\"CS-101\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/courses/CS-101",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "courses",
            "CS-101"
          ]
        }
      }
    },
    {
      "name": "04 Filter by department + sort + limit",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"One Computer Science course\", () => { const b = pm.response.json(); pm.expect(b).to.have.lengthOf(1); pm.expect(b[0].department).to.eql(\"Computer Science\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/courses?department=Computer Science&sort=creditHours&order=desc&limit=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "courses"
          ],
          "query": [
            {
              "key": "department",
              "value": "Computer Science"
            },
            {
              "key": "sort",
              "value": "creditHours"
            },
            {
              "key": "order",
              "value": "desc"
            },
            {
              "key": "limit",
              "value": "1"
            }
          ]
        }
      }
    },
    {
      "name": "05 Create course (cleaned, saves newCode)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Values cleaned by class-transformer\", () => { const b = pm.response.json(); pm.expect(b.code).to.eql(\"CS-420\"); pm.expect(b.title).to.eql(\"Compilers\"); pm.expect(b.tags).to.eql([\"theory\",\"core\"]); });",
              "pm.collectionVariables.set(\"newCode\", pm.response.json().code);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \" cs-420 \",\n  \"title\": \"  Compilers \",\n  \"creditHours\": 3,\n  \"instructor\": \"Dr. Hamza Rauf\",\n  \"department\": \"Computer Science\",\n  \"tags\": [\n    \"Theory\",\n    \"CORE\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/courses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "courses"
          ]
        }
      }
    },
