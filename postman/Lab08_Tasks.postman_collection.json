            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"details mention: code must look like CS-301 or CS-301L\", () => pm.expect(pm.response.json().details.join(' | ')).to.include(\"code must look like CS-301 or CS-301L\"));",
              "pm.test(\"details mention: title must be at least 3 characters\", () => pm.expect(pm.response.json().details.join(' | ')).to.include(\"title must be at least 3 characters\"));",
              "pm.test(\"details mention: creditHours must be at most 4\", () => pm.expect(pm.response.json().details.join(' | ')).to.include(\"creditHours must be at most 4\"));"
            ]
          }
        }
